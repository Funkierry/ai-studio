# 复制成 .env 后填写。.env 不会被提交到 Git。
# 一个密钥都不填也能用：本机装了并登录了 Claude Code / Codex 的话，员工会直接调用它们。

# 指定本机工具用的模型（可选，不填就用工具里的默认模型）
# STUDIO_CLAUDE_CLI_MODEL=
# STUDIO_CODEX_MODEL=

# 克劳德用 Claude。也可以不填，改用 `ant auth login` 登录。
ANTHROPIC_API_KEY=
# STUDIO_CLAUDE_MODEL=claude-opus-5-5

# 阿 G 和小码用 GPT。
OPENAI_API_KEY=
# STUDIO_OPENAI_MODEL=gpt-5
# 每百万 token 的美元价格（输入,输出），用来记账；不填就只记 token 不记钱
# STUDIO_OPENAI_PRICE=

# DeepSeek 员工（阿深、深深……）用 DeepSeek。
DEEPSEEK_API_KEY=
# STUDIO_DEEPSEEK_MODEL=deepseek-flash   # 或 deepseek-v4-pro

# 美元换人民币的汇率，用于账本里的金额
# STUDIO_USD_CNY=7.2
